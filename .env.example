# ==============================================================================
# MaintainWise — 工厂设备维护管理系统环境变量配置文件
# 复制此文件为 .env 并根据现场实际网络与安全规范修改
# ==============================================================================

# ----------------- 应用网关与端口配置 -----------------
APP_PORT=80
APP_SSL_PORT=443

# ----------------- PostgreSQL 数据库配置 -----------------
POSTGRES_USER=maintainwise
POSTGRES_PASSWORD=MaintainWise@2026!
POSTGRES_DB=maintainwise_db
POSTGRES_PORT=5432

# ----------------- Redis 缓存与队列配置 -----------------
REDIS_PASSWORD=MaintainWiseRedis2026
REDIS_PORT=6379

# ----------------- 安全与认证配置 (JWT) -----------------
# 生产环境请务必使用 openssl rand -hex 32 生成高强度密钥
SECRET_KEY=maintainwise_super_secret_jwt_key_2026_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------- 文件与上传大小限制 -----------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# ----------------- 初始超级管理员配置 -----------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=MaintainWiseAdmin@2026
DEFAULT_ADMIN_EMAIL=admin@factory.com
DEFAULT_ADMIN_PHONE=13800000000

# ----------------- 默认邮件 SMTP 服务器配置 (选填，可在后台页面配置) -----------------
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=maintainwise-notice@factory.com
SMTP_PASSWORD=YourSmtpAuthCode
SMTP_FROM=maintainwise-notice@factory.com
SMTP_TLS=true
