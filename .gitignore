# ==============================================================================
# MaintainWise — Git Ignore Configuration (Full Stack Project)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & FastAPI Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. Node.js & Vue 3 Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Databases, Volumes & Runtime State
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
maintainwise.db
pgdata/
redisdata/

# ------------------------------------------------------------------------------
# 4. Uploads, Backups & User Assets
# ------------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
backups/*
!backups/.gitkeep
*.tar.gz
*.sql.gz

# ------------------------------------------------------------------------------
# 5. Environment & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
deploy/nginx/ssl/*.crt
deploy/nginx/ssl/*.key
deploy/nginx/ssl/*.pem
!deploy/nginx/ssl/.gitkeep

# ------------------------------------------------------------------------------
# 6. IDE, Editors & OS Files
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
